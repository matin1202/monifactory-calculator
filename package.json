{
  "name": "monifactory-calc",
  "version": "1.0.0",
  "description": "Monifactory calculator",
  "main": "index.js",
  "scripts": {
    "copy-files": "node scripts/copy-files.mjs",
    "start": "concurrently \"tsc --watch\" \"node scripts/serve.mjs\"",
    "build": "tsc && npm run copy-files",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:snapshot": "jest --updateSnapshot",
    "pretest": "tsc",
    "process-data": "dotnet run --project export/export.csproj -c Release --"
  },
  "keywords": [
    "gregtech",
    "minecraft",
    "calculator"
  ],
  "author": "ShadowTheAge",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "concurrently": "^8.2.2",
    "javascript-lp-solver": "0.4.24",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.8.2",
    "wrangler": "^4.160.0"
  },
  "overrides": {
    "test-exclude": "^8.0.0"
  }
}
